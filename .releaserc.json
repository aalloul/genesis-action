{
  "tagFormat": "v${version}",
  "branches": [
    "main",
    {
      "name": "**",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo ${nextRelease.version} > .next-version"
      }
    ],
    [
      "@semantic-release/github",
      {
        "name": "${nextRelease.gitTag}"
      }
    ]
  ]
}
